{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "lib": [
      "esnext",
      "webworker"
    ],
    "types": [
      "@cloudflare/workers-types"
    ]
  },
  "include": [
    "workers/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
