{
  "name": "@nxcc/cli",
  "version": "0.1.3",
  "description": "CLI for interacting with nXCC nodes",
  "main": "dist/index.js",
  "bin": {
    "nxcc": "dist/index.js"
  },
  "scripts": {
    "prebuild": "node scripts/extract-contract-data.js",
    "build": "tsc && chmod +x dist/index.js",
    "prepack": "pnpm build",
    "prepare": "pnpm build",
    "start": "ts-node src/index.ts",
    "test": "jest",
    "lint": "prettier --check .",
    "format": "prettier --write ."
  },
  "files": [
    "dist/**/*",
    "templates/**/*",
    "package.json",
    "README.md"
  ],
  "keywords": [
    "nxcc"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@nxcc/sdk": "workspace:*",
    "commander": "^14.0.2",
    "viem": "^2.44.4"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.10",
    "esbuild": "^0.27.2",
    "jest": "^30.2.0",
    "prettier": "^3.8.1",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
