{
  "name": "@nxcc/cli",
  "version": "0.1.1",
  "description": "CLI for interacting with nXCC nodes",
  "main": "dist/index.js",
  "bin": {
    "nxcc": "dist/index.js"
  },
  "scripts": {
    "prebuild": "node scripts/extract-contract-data.js",
    "build": "tsc && chmod +x dist/index.js",
    "prepack": "pnpm build",
    "prepare": "pnpm build",
    "start": "ts-node src/index.ts",
    "test": "jest",
    "lint": "prettier --check .",
    "format": "prettier --write ."
  },
  "files": [
    "dist/**/*",
    "templates/**/*",
    "package.json",
    "README.md"
  ],
  "keywords": [
    "nxcc"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@nxcc/sdk": "workspace:*",
    "commander": "^12.0.0",
    "viem": "^2.10.3"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "@types/jest": "^29.5.12",
    "esbuild": "^0.21.4",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "prettier": "^3.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
