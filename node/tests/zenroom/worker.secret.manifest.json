{
  "vm": "nxcc/zenroom",
  "bundle": {
    "source": "./secret_injection.zen"
  },
  "identities": [
    [
      {
        "chain": "mock://policy.example.com",
        "identity_address": "0x1111111111111111111111111111111111111111",
        "identity_id": "777"
      },
      "ZENROOM_SECRET"
    ]
  ],
  "userdata": {
    "zenroom": {
      "mode": "zencode",
      "conf": "debug=0",
      "inputs": {
        "data": {},
        "keys": {
          "injected_secret": {
            "$secret": "ZENROOM_SECRET",
            "kdf": {
              "info": "nxcc-zenroom-e2e",
              "len": 16
            }
          }
        },
        "extra": {},
        "context": {},
        "merge_strategy": "merge"
      },
      "output": {
        "format": "json",
        "json_pointer": "/injected_secret"
      },
      "http": {
        "response_mode": "envelope"
      }
    },
    "postback": {
      "enabled": true,
      "required": true,
      "targets": [
        {
          "kind": "http",
          "url": "http://127.0.0.1:9911/ingest",
          "method": "POST",
          "headers": {
            "content-type": "application/json"
          },
          "body": {
            "from": "stdout",
            "json_pointer": "/injected_secret"
          }
        }
      ]
    }
  }
}
