{
  "name": "nxcc-test-js-workers",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "npm-run-all --parallel build:*",
    "build:policy_test_worker": "esbuild ../policy/test_worker_integration.js --bundle --outfile=dist/test_worker_integration.js --format=esm",
    "build:event_handler_worker": "esbuild event_handler_worker.js --bundle --outfile=dist/event_handler_worker.js --format=esm",
    "build:http_echo_worker": "esbuild http_echo_worker.js --bundle --outfile=dist/http_echo_worker.js --format=esm"
  },
  "devDependencies": {
    "esbuild": "^0.20.0",
    "npm-run-all": "^4.1.5",
    "ethers": "^6.10.0"
  }
}
