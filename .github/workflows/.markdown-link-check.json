{
  "ignorePatterns": [
    {
      "pattern": "^https://via.placeholder.com"
    },
    {
      "pattern": "^localhost"
    },
    {
      "pattern": "^127.0.0.1"
    }
  ],
  "httpHeaders": [
    {
      "urls": ["https://github.com"],
      "headers": {
        "Accept": "text/html"
      }
    }
  ],
  "timeout": "10s",
  "retryOn429": true,
  "retryCount": 3,
  "fallbackRetryDelay": "30s",
  "aliveStatusCodes": [200, 206, 301, 302, 304, 403, 999]
}