---
import fs from "node:fs";
import path from "node:path";
import { fileURLToPath } from "node:url";
import { Code } from "@astrojs/starlight/components";

interface CodeFromFileProps {
  file: string;
  lang?: string;
  title?: string;
  trim?: boolean;
  startLine?: number;
  endLine?: number;
  [key: string]: unknown;
}

const {
  file,
  lang,
  title,
  trim = false,
  startLine,
  endLine,
  ...rest
} = Astro.props as CodeFromFileProps;

if (!file || typeof file !== "string") {
  throw new Error("<CodeFromFile /> requires a string `file` prop");
}

const docsDir = fileURLToPath(new URL("../..", import.meta.url));
const repoRoot = path.resolve(docsDir, "..");
const resolvedPath = path.resolve(repoRoot, file);

const maybeAddWatchFile = (Astro as { addWatchFile?: (path: string) => void }).addWatchFile;
if (typeof maybeAddWatchFile === "function") {
  maybeAddWatchFile(resolvedPath);
}

const rawCode = fs.readFileSync(resolvedPath, "utf-8");
const allLines = rawCode.split(/\r?\n/);

const adjustLineNumber = (value: number | undefined, fallback: number, bound: number) => {
  if (typeof value !== "number" || !Number.isInteger(value)) return fallback;
  return Math.min(Math.max(value, 1), bound);
};

const totalLines = allLines.length;
const sliceStart = adjustLineNumber(startLine, 1, totalLines);
const sliceEnd = adjustLineNumber(endLine, totalLines, totalLines);

if (sliceStart > sliceEnd) {
  throw new Error(
    `<CodeFromFile /> received invalid line range: start (${sliceStart}) is greater than end (${sliceEnd})`,
  );
}

const slicedLines = allLines.slice(sliceStart - 1, sliceEnd);
let code = slicedLines.join("\n");
if (trim) {
  code = code.trim();
}

const inferredLang = path.extname(resolvedPath).slice(1) || "txt";
const codeLang = typeof lang === "string" && lang.length > 0 ? lang : inferredLang;
const codeTitle = typeof title === "string" && title.length > 0 ? title : file;
---

<Code code={code} lang={codeLang} title={codeTitle} {...rest} />
