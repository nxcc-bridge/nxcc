---
import Layout from "../layouts/Layout.astro";
---

<Layout title="My Docs - The Future is Decentralized">
  <main class="flex h-full flex-col items-center justify-center p-4">
    <div class="text-center">
      <h1 class="text-5xl font-bold sm:text-7xl">
        <span
          class="bg-gradient-to-r from-amber-400 to-primary bg-clip-text text-transparent"
        >
          My Docs
        </span>
      </h1>
      <p class="mt-4 text-lg text-slate-400 sm:text-xl">
        A revolutionary platform for the next generation of decentralized
        applications.
      </p>
      <div class="mt-8">
        <a
          href="/guides/getting-started/"
          class="rounded-md bg-primary px-8 py-3 text-lg font-semibold text-white shadow-lg transition-transform duration-200 hover:scale-105 hover:bg-primary-dark focus:outline-none focus:ring-2 focus:ring-primary focus:ring-opacity-50"
        >
          Get Started
        </a>
      </div>
    </div>
  </main>
</Layout>
