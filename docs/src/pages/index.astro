            >
            <a href="#use-cases" class="text-gray-600 hover:text-gray-900"
              >Use Cases</a
            >
            <a href="/docs" class="text-gray-600 hover:text-gray-900">Docs</a>
            <a
              href="https://github.com/nxcc-bridge/nxcc"
              class="text-gray-600 hover:text-gray-900">GitHub</a
            >
          </div>
          <!-- TODO: Add mobile menu button and functionality. -->
        </nav>
      </div>
    </header>

    <main class="relative z-10">
      <section class="py-20 text-center md:py-32">
        <div class="container mx-auto px-4">
          <h1
            class="text-4xl font-bold tracking-tighter text-gray-900 md:text-6xl"
