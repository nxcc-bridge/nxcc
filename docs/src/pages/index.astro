              Get Started
            </a>
          </div>
        </div>
      </section>
    </main>
  </div>

  <div class="container mx-auto px-4">
    <section class="py-16 text-center md:py-24">
      <h2 class="text-3xl font-bold tracking-tight text-gray-900 md:text-4xl">
        Web3 is Fragmented. Your Solution Shouldn't Be.
      </h2>
      <p class="mx-auto mt-6 max-w-3xl text-lg text-gray-600">
